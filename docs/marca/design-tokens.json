{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Nexo",
    "version": "3.0",
    "status": "approved visual direction, logo exploratory",
    "note": "Colors are fixed. Semantic UI colors to be defined and contrast-tested."
  },
  "colors": {
    "brand": {
      "coreNavy": "#0B172B",
      "nexoMint": "#69E1C7",
      "signalBlue": "#4B8FF7",
      "canvasWhite": "#F5F8FC",
      "steelGray": "#71849B",
      "surfaceNavy": "#17283F"
    }
  },
  "typography": {
    "display": {"family": "Space Grotesk", "weights": [500, 600, 700]},
    "body": {"family": "Inter", "weights": [400, 500, 600]}
  },
  "spacingPx": [4, 8, 12, 16, 24, 32, 48, 64],
  "radiusPx": {"sm": 8, "md": 12, "lg": 16, "pill": 999},
  "icon": {"family": "Lucide", "strokeWidthRange": [1.75, 2]},
  "motionMs": {"min": 150, "max": 250},
  "touchTargetPx": 44,
  "logo": {
    "mark": "interwoven ribbon N",
    "gradient": ["#69E1C7", "#4B8FF7"],
    "wordmark": "nexo",
    "reference": "assets/reference/nexo_brand_direction_approved.png",
    "finalArtworkReady": false
  }
}
