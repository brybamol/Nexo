# Opcional. Si existe, la captura y las preguntas usan Claude; si no, el intérprete Local.
ANTHROPIC_API_KEY=

# Opcional. Si existe, se usa PostgreSQL (pg); si no, PGlite local.
DATABASE_URL=

# Opcional. Carpeta donde PGlite guarda los datos (por defecto <cwd>/.data/pglite).
# Úsala para sacarlos del repo, p. ej. si está en OneDrive. Ruta absoluta: Next no expande %VAR%.
# NEXO_DATA_DIR=C:\Users\tu-usuario\AppData\Local\Nexo\pglite
# NEXO_DATA_DIR=/home/tu-usuario/.local/share/nexo/pglite
NEXO_DATA_DIR=

# Conexión con Gmail (opcional). Credenciales OAuth de Google Cloud; la URI de retorno termina en /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Cifra el token de Google guardado en la base: 32 bytes en base64 (openssl rand -base64 32).
NEXO_CLAVE_CIFRADO=
# Usuario y clave de administración para /api/auth/google y /api/gmail/* (HTTP Basic). Sin ellos, esas rutas quedan cerradas.
NEXO_ADMIN_USUARIO=
NEXO_ADMIN_CLAVE=
# Remitentes autorizados: JSON correo → id de persona, p. ej. {"paola@empresa.com":"paola"}.
NEXO_EMAIL_REMITENTES=
# Webhook de correo entrante (Postmark), con HTTP Basic.
NEXO_EMAIL_WEBHOOK_USER=
NEXO_EMAIL_WEBHOOK_PASSWORD=
